[sub_resource type="Resource" id="Resource_38p18"]
script = ExtResource("3_38p18")
text = "Welcome, player, and congratulations, this time you will REALLY be tested on your decision-making and orientation skills in the maze... but I’m still a little afraid that it might be too hard for you, so here’s a little hint from me."
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

[sub_resource type="Resource" id="Resource_3sjsf"]
script = ExtResource("3_38p18")
id = 1
text = "This one was more complicated, wasn’t it? Fortunately, I helped you, just a little bit. There’s no need to thank me, that’s my duty."
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

[sub_resource type="Resource" id="Resource_dy0pr"]
script = ExtResource("3_38p18")
id = 2
text = "Did I overestimate you? Maybe you didn’t understand the principle of a maze earlier since all paths led to the exit. But you didn’t understand the principle of an arrow EITHER ? That wasn’t part of the plan. Don’t worry, I’ll help you finish the level."
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

[sub_resource type="Resource" id="Resource_t7ntf"]
script = ExtResource("3_38p18")
id = 3
text = "What a strange color, is that…? No, do not pay attention, keep going."
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

[sub_resource type="Resource" id="Resource_qii4q"]
script = ExtResource("3_38p18")
id = 4
text = "Do you find this wall too high ? That’s normal, it’s a test, I’m sure you can overcome it. There’s no need to go back earlier in the level, all you need is the double jump."
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

[sub_resource type="Resource" id="Resource_aid2e"]
script = ExtResource("3_38p18")
id = 5
text = "NO ! No no no, it will NOT happen under my oversight ! Congratulations on your efforts, go to the next level !"
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

