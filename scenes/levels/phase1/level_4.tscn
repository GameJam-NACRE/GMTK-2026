[sub_resource type="Resource" id="Resource_qkm74"]
script = ExtResource("3_4ld1b")
text = "Player, welcome to… the maze level. Do you know what it is? Large winding corridors, only one leads to the exit ? With this limited time, you’ll have to do your best, good luck !"
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

[sub_resource type="Resource" id="Resource_4ld1b"]
script = ExtResource("3_4ld1b")
id = 1
text = "Were you afraid ? It was only to make you understand the principle of a maze, I... wasn’t sure if you knew it. I hope you had fun !"
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

