[sub_resource type="Resource" id="Resource_toupk"]
script = ExtResource("3_4od8l")
text = "Within a level, you can sometimes get items that will disappear at the end of it. Let’s introduce them."
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

[sub_resource type="Resource" id="Resource_4msyu"]
script = ExtResource("3_4od8l")
id = 1
text = "Here you are in front of a door. You will need a key to open it. It is one of the items, you can do it."
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

[sub_resource type="Resource" id="Resource_jbkxo"]
script = ExtResource("3_4od8l")
id = 2
text = "Well done. You can now go back to the door, open it by using the key with E, and resume your adventure."
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

[sub_resource type="Resource" id="Resource_avip2"]
script = ExtResource("3_4od8l")
id = 3
text = "You have now gain a coin. Unlike the key, it has no effect on its own. But once you get 5 of them, it will have an impressive effect. Go for it !"
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

