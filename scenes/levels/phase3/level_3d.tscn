[sub_resource type="Resource" id="Resource_r7044"]
script = ExtResource("2_r7044")
text = "Urgh, it’s... it’s even worse than I thought, I really wasn’t meant to be played like that. All right, is it hideous enough to make you stop playing and chasing the CountDown ?"
