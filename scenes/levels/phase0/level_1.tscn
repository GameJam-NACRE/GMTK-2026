[sub_resource type="Resource" id="Resource_l5rba"]
script = ExtResource("3_l5rba")
text = "Get ready for the most action-packed level yet. Terrible, bloodthirsty creatures want to hurt you and your only weapon is... to run. Good luck."
audio = ExtResource("4_y5kio")
dial_long_pause = 0.7
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

[sub_resource type="Resource" id="Resource_in5ib"]
script = ExtResource("3_l5rba")
id = 1
text = "Here is your first enemy. He can’t really hurt you, only push you away, but neither can you. I advise you to dodge him."
audio = ExtResource("5_w2068")
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

[sub_resource type="Resource" id="Resource_vnqil"]
script = ExtResource("3_l5rba")
id = 2
text = "That changes things. You can now use your sword with ENTER to fight monsters blocking your way."
audio = ExtResource("6_kcaiu")
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

[sub_resource type="Resource" id="Resource_rxacq"]
script = ExtResource("3_l5rba")
id = 3
text = "Congratulations ! Did you notice ? Defeating one of these enemies gives you extra time. So do it as much as possible !"
audio = ExtResource("7_08mu6")
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

[sub_resource type="Resource" id="Resource_gf0b5"]
script = ExtResource("3_l5rba")
id = 4
text = "Did you have fun ? You know how to move around and even defeat enemies. You look more and more like a hero."
audio = ExtResource("8_5h4ci")
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

