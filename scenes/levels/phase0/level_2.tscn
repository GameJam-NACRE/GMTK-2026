[sub_resource type="Resource" id="Resource_jmpsw"]
script = ExtResource("3_d3vam")
text = "You have another key mechanic to master. You can jump, but have you ever tried to jump while sliding against a wall ? Press SPACE when you’re up against a wall to discover it."
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

[sub_resource type="Resource" id="Resource_d3vam"]
script = ExtResource("3_d3vam")
id = 1
text = "I never doubted you. But I will have to do it now, in order to make sure that it was not a fluke. Please finish the level to prove it."
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

[sub_resource type="Resource" id="Resource_dejfp"]
script = ExtResource("3_d3vam")
id = 2
text = "Nice job, player, you’ve mastered the game’s basics. Now get ready for more complex levels, but more importantly, lots of fuuuuuuuuuuuun."
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

