[sub_resource type="Resource" id="Resource_15vnu"]
script = ExtResource("3_l1gp7")
text = "Hello player, and welcome to the game. The principle is easy : reach the finish before the CountDown goes down to 0. And above all, have fun. You can move with the arrow keys and jump by pressing SPACE."
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

[sub_resource type="Resource" id="Resource_vn08v"]
script = ExtResource("3_l1gp7")
id = 1
text = "Movements and jumps are more complex than they look. By pressing SHIFT, you move a little faster. And pressing SPACE longer makes you jump higher."
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

[sub_resource type="Resource" id="Resource_l1gp7"]
script = ExtResource("3_l1gp7")
id = 2
text = "Do you see this flag ? It represents the end of the level. Touch it and you will reach the next level."
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

