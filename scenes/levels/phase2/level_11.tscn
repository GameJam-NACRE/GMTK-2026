[sub_resource type="Resource" id="Resource_7wqkl"]
script = ExtResource("3_5mjhn")
text = "You won’t make it. I control everything here !"
audio = ExtResource("4_ajco6")
dial_char_speed = 0.035
dial_short_pause = 0.35
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

[sub_resource type="Resource" id="Resource_nsf15"]
script = ExtResource("3_5mjhn")
id = 1
text = "Aaaaaaand here ! You see? There’s no need to resist ! Go back, NOW!"
audio = ExtResource("5_urcay")
dial_short_pause = 0.35
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

[sub_resource type="Resource" id="Resource_vvgew"]
script = ExtResource("3_5mjhn")
id = 2
text = "You dummy ! Did you see any door ? It was a setup so that you would be trapped ! And now you’re stu… oh no."
audio = ExtResource("6_reks6")
dial_char_speed = 0.07
dial_short_pause = 0.35
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

[sub_resource type="Resource" id="Resource_f47xn"]
script = ExtResource("3_5mjhn")
id = 3
text = "Hm. It doesn’t work as well as I would like, but that’s something. Annoying, isn’t it ? Turn back. Please."
audio = ExtResource("7_eposg")
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

[sub_resource type="Resource" id="Resource_yhoni"]
script = ExtResource("3_5mjhn")
id = 4
text = "Well, back to the beginning, bravo. And now? You’re stuck, and the wall I just created is indestructible, so you have no choice but to leave the game. Thank you for the ride and goodbye !"
audio = ExtResource("8_64huf")
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

