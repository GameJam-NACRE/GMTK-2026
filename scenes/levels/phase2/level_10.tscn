[sub_resource type="Resource" id="Resource_p4vui"]
script = ExtResource("3_66j3m")
text = "Well, during the transition... yes, I thought that this voice was more likely to convince you. As I was saying, I came to a simple conclusion : your weapon was a hindrance. So, you no longer have it. And know that I have some monsters in store. It’s time for you to give up."
audio = ExtResource("4_uimdg")
dial_long_pause = 1.0
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

[sub_resource type="Resource" id="Resource_ll055"]
script = ExtResource("3_66j3m")
id = 1
text = "HAHA, did you really think I couldn’t do it ? Right, any resistance is futile, you can give up your efforts and return to the fun corridor. Immediately, please."
audio = ExtResource("5_p4vui")
dial_long_pause = 1.0
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

[sub_resource type="Resource" id="Resource_fv8in"]
script = ExtResource("3_66j3m")
id = 2
text = "Really ? You didn’t even hesitate ?"
audio = ExtResource("6_ll055")
dial_long_pause = 1.0
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

