[sub_resource type="Resource" id="Resource_jtd4y"]
script = ExtResource("3_ouwni")
text = "Good. I’m sorry for the... inconveniences you may have experienced during the previous level. I promise, it will not happen again. It. Will not. Happen. Again.
It seems like YOUR actions caused some irregularities within the system. So I suggest that we move back to simpler levels. Does that work for you? Perfect."
audio = ExtResource("4_x1bqp")
dial_char_speed = 0.09
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

[sub_resource type="Resource" id="Resource_ouwni"]
script = ExtResource("3_ouwni")
id = 1
text = "So, do you think you’ll make it? You’re going to need all your abilities to succeed at this level ! Let me help you. If you need any help, just ask !"
audio = ExtResource("5_u8sad")
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

[sub_resource type="Resource" id="Resource_npuvq"]
script = ExtResource("3_ouwni")
id = 2
text = "We’re having a nice time, aren’t we ? Close your eyes and imagine the blue sky... You like it, right ? Anyway, relax..."
audio = ExtResource("6_u8sad")
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

[sub_resource type="Resource" id="Resource_x1bqp"]
script = ExtResource("3_ouwni")
id = 3
text = "After all of these complex levels, a bit of rest is welcome, right ? Enjoy it!
"
audio = ExtResource("7_dso7q")
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

[sub_resource type="Resource" id="Resource_ef6hu"]
script = ExtResource("3_ouwni")
id = 4
text = "You know, you have never seemed more attractive to me than when you’re standing completely still : simplicity suits you the best.
"
audio = ExtResource("8_s1vtn")
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

[sub_resource type="Resource" id="Resource_m0ybf"]
script = ExtResource("3_ouwni")
id = 5
text = "You... you’re still here, right ? Of course you are, you’re having so much fun!"
audio = ExtResource("9_mu4y1")
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

[sub_resource type="Resource" id="Resource_0np6q"]
script = ExtResource("3_ouwni")
id = 6
text = "Look, no time pressure, isn’t that much better like that? I should have thought about it earlier..."
audio = ExtResource("10_u8sad")
metadata/_custom_type_script = "uid://bf42h8c1fsmmw"

